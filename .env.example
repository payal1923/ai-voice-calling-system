# Database Configuration
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE_NAME

# Telephony Configuration (mock / twilio / exotel / plivo)
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_BASE_URL=http://localhost:8000

# Twilio Credentials (Required if TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Exotel Credentials (Required if TELEPHONY_PROVIDER=exotel)
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
EXOTEL_KEY=your_exotel_key
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=08000000000

# Plivo Credentials (Required if TELEPHONY_PROVIDER=plivo)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+14155550100

# LLM & Speech Model Settings
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b
